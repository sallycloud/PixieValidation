<Project>
    <PropertyGroup>
        <Version>0.2.0</Version>
        <TargetFramework>net10.0</TargetFramework>
        <Authors>sallycloud</Authors>
        <Description>Lightweight validation framework: rule functions, path-aware error collection, no value-object/converter overhead.</Description>
        <RepositoryUrl>https://github.com/sallycloud/PixieValidation</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageId>PixieValidation</PackageId>
    </PropertyGroup>

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <PropertyGroup>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    
</Project>